# Copy this file to ".env" and fill it in. .env is gitignored and must stay that way.
#
# NOTE: nothing in this file is ever a private key or a seed phrase. PAY_TO_ADDRESS is a public
# RECEIVING address -- the kind you'd paste into someone's "send me money" box. This service
# never signs a transaction, never holds funds, and never needs a wallet's secret. If any guide
# ever tells you to put a private key in a server .env, that guide is wrong.

# --- Payments ---------------------------------------------------------------------------
# Your public EVM address on Base. Payments land here directly.
# Leave BLANK to run in free mode (no paywall) while testing the check logic.
PAY_TO_ADDRESS=

# Price per call, as a dollar string. The facilitator converts to USDC.
PRICE=$0.02

# The agent-written brief endpoint. Priced higher because it costs real model tokens to serve
# (~$0.05/call on the default model, measured) where /safety costs a fraction of a cent.
BRIEF_PRICE=$0.15

# eip155:84532 = Base Sepolia (TESTNET, valueless test USDC)  <- start here
# eip155:8453  = Base mainnet (REAL money)                    <- only after testnet works
NETWORK=eip155:84532

# The facilitator verifies the payment signature and actually moves the USDC.
#
# IMPORTANT: this one is TESTNET ONLY. It does not serve Base mainnet. Switching NETWORK to
# mainnet while still pointed here produces a service that looks healthy, 402s every caller,
# and can never settle a single payment. The server refuses to start in that combination.
FACILITATOR_URL=https://x402.org/facilitator

# --- Mainnet only ------------------------------------------------------------------------
# To take real money you need a production facilitator. Coinbase's CDP one is free for the
# first 1,000 settlements per month, then $0.001 each. Create a key pair at
# portal.cdp.coinbase.com and set both values; the server then uses CDP automatically and
# ignores FACILITATOR_URL above.
#
# These are API credentials, not a wallet key -- they let the server ASK the facilitator to
# settle. They cannot move funds on their own and are not a seed phrase.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- The brief agent ---------------------------------------------------------------------
# Required only for GET /brief/<mint>. /safety works without it.
ANTHROPIC_API_KEY=

# Defaults to claude-opus-5 (~$0.05/call, measured). claude-sonnet-5 is roughly 5x cheaper with a
# real quality tradeoff -- change it deliberately, not by default.
#
# claude-haiku-4-5 also works and is cheaper still, but note it does NOT accept the effort
# parameter; the code omits effort automatically for such models rather than sending a request
# the API rejects with a 400.
BRIEF_MODEL=

# --- Solana RPC -------------------------------------------------------------------------
# Blank = the free public endpoint. Fine for testing; it rate-limits hard (HTTP 429) and will
# not survive real traffic. See README "The RPC problem".
RPC_ENDPOINT=

PORT=3000
